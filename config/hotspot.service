[Unit]
Description=Open a Wifi HotSpot for init

After=network-online.target NetworkManager.service
Wants=network-online.target
Requires=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/nmcli c add type wifi ifname wlan0 con-name 3dprinter autoconnect yes ssid 3dprinter \
802-11-wireless.mode ap 802-11-wireless.band bg ipv4.method shared ipv4.addresses 192.168.4.1/24

ExecStart=/usr/bin/nmcli c up 3dprinter

ExecStartPost=/usr/bin/systemctl disable hotspot.service


[Install]
WantedBy=multi-user.target
